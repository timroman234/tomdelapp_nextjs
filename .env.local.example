# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# GitHub write access (the admin commits content changes via GitHub's Contents API)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Anthropic (chat agent)
ANTHROPIC_API_KEY=

# Deepgram (voice transcription)
DEEPGRAM_API_KEY=

# Google OAuth (admin login) — create an OAuth 2.0 Client ID in Google Cloud Console,
# with authorized redirect URIs for both http://localhost:3000/api/auth/callback/google
# and https://<your-vercel-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Random secret for NextAuth session encryption — generate with: openssl rand -base64 32
AUTH_SECRET=

# Comma-separated list of Google account emails allowed to sign in to /admin
ALLOWED_EMAILS=
